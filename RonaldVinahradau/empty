import pandas as pd
import numpy as np

file_path = r"C:\Users\ronald\Downloads\Automobile.csv"
df = pd.read_csv(file_path)


features = ["weight", "horsepower", "cylinders", "mpg"]
target = "acceleration"

df = df.replace("?", np.nan).dropna()
df[features + [target]] = df[features + [target]].astype(float)
limit = 17 

df["category"] = (df[target] > limit).astype(int)  


print("Kategorie 0 (≤ {}s):".format(limit), (df["category"] == 0).sum())
print("Kategorie 1 (> {}s):".format(limit), (df["category"] == 1).sum())



train_size = int(0.8 * len(df))
X = df[features].values
y = df["category"].values

X_train, X_test = X[:train_size], X[train_size:]
y_train, y_test = y[:train_size], y[train_size:]


class Perceptron:
    def __init__(self, lr=0.01, epochs=1000):
        self.lr = lr
        self.epochs = epochs
        self.weights = None
        self.bias = 0

    def step(self, x):
        return 1 if x >= 0 else 0

    def fit(self, X, y):
        n_samples, n_features = X.shape
        self.weights = np.zeros(n_features)
        self.bias = 0

        for _ in range(self.epochs):
            for i in range(n_samples):
                linear_output = np.dot(X[i], self.weights) + self.bias
                y_pred = self.step(linear_output)
                error = y[i] - y_pred

                self.weights += self.lr * error * X[i]
                self.bias += self.lr * error

    def predict(self, X):
        return np.array([self.step(np.dot(x, self.weights) + self.bias) for x in X])


model = Perceptron(lr=0.01, epochs=1000)
model.fit(X_train, y_train)
y_pred = model.predict(X_test)


echtpercent_0 = (y_test == 0).mean() * 100
echtpercent_1 = (y_test == 1).mean() * 100

ratpercent_0 = (y_pred == 0).mean() * 100
ratpercent_1 = (y_pred == 1).mean() * 100

print(f"\nEchte Verteilung:")
print(f" - erste  (≤ {limit} s): {echtpercent_0:.2f}%")
print(f" - Kategorie 1 (> {limit} s): {echtpercent_1:.2f}%")
print(f"\nVorhergesagte Verteilung:")
print(f" - Kategorie 0 (≤ {limit} s): {ratpercent_0:.2f}%")
print(f" - Kategorie 1 (> {limit} s): {ratpercent_1:.2f}%")


accuracy = (y_pred == y_test).mean() * 100
print(f"\nGenauigkeit des Modells: {accuracy:.2f}%")
